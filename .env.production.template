# 生产环境配置模板
# 使用方法：复制为 .env.production 并填写实际值

# ============================================
# 后端配置
# ============================================

# 启用后端调用
VITE_USE_BACKEND=true

# 后端 URL（部署后端后填写）
VITE_API_BASE_URL=https://your-backend-url.workers.dev

# ============================================
# 安全密钥（必须与后端一致）
# ============================================

# AES 加密密钥（与 backend/wrangler.toml 中的 ENCRYPTION_SECRET 一致）
VITE_ENCRYPTION_SECRET=your-64-char-hex-encryption-secret

# HMAC 签名密钥（与 backend/wrangler.toml 中的 HMAC_SECRET 一致）
VITE_HMAC_SECRET=your-64-char-hex-hmac-secret

# ============================================
# 注意事项
# ============================================
# 1. VITE_API_BASE_URL 必须替换为后端实际部署的 URL
# 2. 密钥必须与后端完全一致，否则签名验证会失败
# 3. 不要将此文件提交到公开仓库
